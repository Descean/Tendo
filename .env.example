# ============================================================
#  Tendo – Configuration (.env)
#  En production : copier et remplir toutes les valeurs
# ============================================================

# === Database ===
# DEV LOCAL (SQLite)
# DATABASE_URL=sqlite+aiosqlite:///./tendo.db
# DATABASE_URL_SYNC=sqlite:///./tendo.db
# PRODUCTION (PostgreSQL) — OBLIGATOIRE sur le serveur
DATABASE_URL=postgresql+asyncpg://tendo_user:MOT_DE_PASSE@localhost:5432/tendo_db
DATABASE_URL_SYNC=postgresql+psycopg2://tendo_user:MOT_DE_PASSE@localhost:5432/tendo_db

# === Redis (optionnel pour le MVP) ===
REDIS_URL=redis://localhost:6379/0

# === WhatsApp – Meta Cloud API (GRATUIT, 1000 conv/mois) ===
WHATSAPP_PROVIDER=meta
META_PHONE_NUMBER_ID=your_phone_number_id
META_ACCESS_TOKEN=your_meta_access_token
META_VERIFY_TOKEN=tendo_verify_token_2024
META_APP_SECRET=your_app_secret
META_BUSINESS_ACCOUNT_ID=your_business_account_id

# === IA Conversationnelle (cascade : Groq > Gemini > Claude) ===
# Groq (GRATUIT : 30 req/min, Llama 3.3 70B)
GROQ_API_KEY=gsk_votre_cle_groq
# Gemini (GRATUIT : 15 req/min, 1M tokens/jour + Vision OCR)
GEMINI_API_KEY=votre_cle_gemini
# Claude (PREMIUM — optionnel, abonnes premium)
CLAUDE_API_KEY=sk-ant-votre_cle_claude

# === FedaPay – Mobile Money (MTN/Moov Benin) ===
# https://fedapay.com — sandbox: sk_sandbox_ / live: sk_live_
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxxxxxxxxxxxxxxxxxx
FEDAPAY_PUBLIC_KEY=pk_sandbox_xxxxxxxxxxxxxxxxxxxxxxxx
FEDAPAY_WEBHOOK_SECRET=your_webhook_secret
FEDAPAY_APP_ID=
FEDAPAY_APP_SECRET_KEY=
FEDAPAY_APP_URL=

# === Email (SMTP + IMAP) ===
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# === Securite ===
# IMPORTANT: Generer une cle forte avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
# Cette cle sert aussi de mot de passe admin (login: admin / password: SECRET_KEY)
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === Scraping (cron: minute heure jour mois jour_semaine) ===
SCRAPING_SCHEDULE=0 6 * * *

# === Admin ===
ADMIN_EMAILS=["admin@shiftup.bj"]
ADMIN_PHONES=["22940809108"]

# === App ===
APP_NAME=Tendo
APP_ENV=production
APP_DEBUG=false
BASE_URL=https://tendo.shiftup.bj
